httpd.pid
# mac osx files
.DS_Store

# python bytecode caches (e.g. from skill scripts) — never committed (any depth)
__pycache__/
*.py[cod]

# node dependencies — installed from package.json + lockfile, never committed (any depth)
node_modules/

# environment files — ignore every .env (and .env.* local variants) at any depth,
# but keep the committed templates. Covers scripts/tracker/.env and scripts/vcs/.env.
.env
.env.*
!.env.example
/agent-db/
/paotung-template/
/agent-webservice/
/agent-paotung-cypress/

# .superset runtime state (pidfiles + service logs from run.sh)
.superset/run/
.superset/logs/

# Slack-dispatcher per-worktree runtime context (correlationId + reply target the
# dispatched agent posts back with; written into each worktree, never committed).
.aiworks/

# logs
agent_logs/
docs/brd/
docs/*.html

# skill-creator scratch workspaces (eval sandboxes, skill snapshots, benchmark runs).
# Reproducible iteration artifacts — never committed to the workspace meta-repo.
.claude/skills/**/evals/
.claude/skills/*-workspace/

# settings.local.json backup written by `aiworks sync` when it preps the image-gen config
# (settings.local.json itself is ignored via the global gitignore).
.claude/settings.local.json.bak

# Runtime cache of the resolved output language, written by the resolve-language hook so
# non-interactive tooling (the tracker adapter's language gate) reads the same resolution.
# Derived state, per-machine — never committed.
.claude/.resolved-language

# Personal, non-shared workspace-config overrides — the workspace-config analogue of
# .claude/settings.local.json. workspace.config.local.yaml overrides workspace.config.yaml
# for everything read at runtime (chat, agents, interactive skills); it is git-ignored so
# your prefs never travel to teammates. The committed workspace.config.local.example.yaml
# documents the pattern (kept, since the ignore matches only the exact real filename).
workspace.config.local.yaml

# product repo clones (cloned by aiworks; not committed to the workspace meta-repo)
/backoffice/
/ofb-backoffice-cypress/
/front-end/
/ofb-instruction/
/customization-widget/
*.code-workspace
!ai-workspace.code-workspace
/mock-agency-api/
/commission-batch/
/seamless-api/
/game/
/cashback-batch/
/crypto-watcher/
/bet-aggregator/
/campaign-sub/
/live-sub/
/ofb-k6-loadtests/
/lotto-service/
/dev-script/

# Generated by `aiworks cursor`: every product repo's instruction and rules, re-globbed
# so they fire for a Cursor session opened at the workspace root. Derived from the repo
# clones — regenerated, never committed.
#
# FILES, not the directory. A directory pattern (`.cursor/rules/repos/`) makes Cursor
# skip the whole tree and silently lose every rule in it; excluding only the .mdc files
# leaves the directories traversable, and Cursor still reads them. Measured both ways.
.cursor/rules/repos/**/*.mdc


# product repo clones (cloned by aiworks; not committed to the workspace meta-repo).
# `aiworks add` appends one ANCHORED `/<repo-dir>/` line per onboarded repo below this
# comment, and `aiworks remove` drops it again — no hand-editing needed. The leading
# slash matters: a bare `<repo>/` matches at every depth, so it would also hide
# `.cursor/rules/repos/<repo>/` and take that repo's whole Cursor rule set down with it.

/turnover-commission-batch/

# >>> aiworks cursor: plugin-skill links (generated — do not edit by hand)
# Symlinks into ~/.claude/plugins — absolute, per-machine paths, so committing one
# gives every teammate a dangling skill dir. Cursor still READS an ignored skill
# directory (measured), so ignoring these costs nothing but the git noise.
/.claude/skills/cavecrew
/.claude/skills/caveman-compress
/.claude/skills/caveman-stats
/.claude/skills/caveman-commit
/.claude/skills/caveman-help
/.claude/skills/caveman-review
/.claude/skills/frontend-design
# <<< aiworks cursor: plugin-skill links
