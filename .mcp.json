{
  "mcpServers": {
    "mcp-image": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-image"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "IMAGE_OUTPUT_DIR": "${IMAGE_OUTPUT_DIR:-/tmp/aiworks-generated-images}",
        "IMAGE_QUALITY": "balanced"
      }
    },
    "sonarqube": {
      "type": "http",
      "url": "http://localhost:25434/mcp",
      "headers": {
        "Authorization": "Bearer ${SONARQUBE_TOKEN}"
      }
    },
    "postgres_main": {
      "type": "sse",
      "url": "http://localhost:25432/sse"
    },
    "postgres_secondary": {
      "type": "sse",
      "url": "http://localhost:25433/sse"
    },
    "redis": {
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "graphify_docs": {
      "type": "stdio",
      "command": "graphify-mcp"
    }
  }
}
