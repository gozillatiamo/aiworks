# Copy to `.env` (this dir) and fill in. The .env is git-ignored (workspace's blanket
# .env / .env.* rule already covers this dir — nothing extra to add to .gitignore).

# signoz (the only provider today)
OBSERVABILITY_PROVIDER=signoz

# Base URL of the SigNoz instance (no trailing slash).
SIGNOZ_BASE_URL=https://signoz.afufc.com

# API key / Personal Access Token, sent in the SIGNOZ_AUTH_HEADER below.
SIGNOZ_API_KEY=

# Header name the instance expects the key on. SigNoz's default PAT header is
# SIGNOZ-API-KEY; override if this instance sits behind a proxy expecting something
# else (e.g. Authorization).
# SIGNOZ_AUTH_HEADER=SIGNOZ-API-KEY
