# Copy to `.env` (this dir) and fill in. The .env is git-ignored (root .gitignore
# globs .env at any depth). Loaded by run.sh and by `python -m aiworks_dispatch`.

# ── Slack (Socket Mode) ───────────────────────────────────────────────────────
# Bot token (xoxb-…): scopes app_mentions:read + chat:write (and channels:join +
# channels:read if you want the bot to self-join public channels). May be the SAME
# token as scripts/notify/.env if you extend that app, or a new dedicated app's.
SLACK_BOT_TOKEN=xoxb-...
# App-level token (xapp-…) with scope connections:write — enables Socket Mode.
SLACK_APP_TOKEN=xapp-...

# ── Trigger allowlist (DEFAULT DENY) ──────────────────────────────────────────
# Comma-separated. The bot dispatches only when the channel OR the user matches.
# Leaving BOTH empty denies every mention (a loud warning is logged at boot).
# #dev-oneforbet:
ALLOWED_CHANNEL_IDS=C04NZCMAG94
# ALLOWED_USER_IDS=U0123456789

# ── Superset (local host CLI) ─────────────────────────────────────────────────
# The OFB meta-repo project (this workspace). `superset projects list` to confirm.
SUPERSET_PROJECT_ID=04576484-8338-4cc8-a703-276f800d228a
# Leave SUPERSET_HOST_ID empty to target this machine (--local). Set it to run on
# a different registered host.
# SUPERSET_HOST_ID=
SUPERSET_AGENT_PRESET=claude
SUPERSET_BASE_BRANCH=develop
# Worktree creation runs the project's setup.sh (heavy: clones + installs). Bump if
# a first-time worktree takes longer than 30 min.
DISPATCH_TIMEOUT_SEC=1800
# Optional — only if you use an API key instead of `superset auth login` (OAuth).
# SUPERSET_API_KEY=sk_live_...

# The OFB meta-repo MAIN clone — its scripts/notify/.env holds the Slack bot token
# the dispatched agent posts back with. Defaults to this repo's root; override only
# if the service runs from elsewhere.
# WORKSPACE_ROOT=/Users/you/projects/bluepi/ai-workspace

# ── Redis (dedup + correlation store) ─────────────────────────────────────────
# The dedicated container from docker-compose.yml (host port 6370).
REDIS_URL=redis://localhost:6370/0
# DEDUP_TTL_SEC=86400
# CONTEXT_TTL_SEC=604800

# LOG_LEVEL=info
