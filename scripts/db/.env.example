# pg-triage — READ-ONLY deployed Postgres DSNs (STAGING + PRODUCTION).
#
# Copy to scripts/db/.env and fill in real values. The real .env is git-ignored (blanket
# .env rule) AND blocked by the workspace .env-guard hook — never Read/cat/grep it; only
# the pg_triage_mcp.py server process reads it.
#
# HARD RULE: every DSN here — staging included — MUST use a READ-ONLY database role. The server
# also forces a read-only transaction + 15s statement_timeout as a backstop, but the read-only
# role is the real guarantee. Do not put a read-write account here.
#
# Which environment a call touches is chosen per call by `env` ("staging" | "prod"), never
# defaulted; production is additionally gated by `triage.prod` in workspace.config.local.yaml.
#
# Topology per environment:
#   prod     — MAD is the master; ASS player data is sharded across 16 shards addressed by hex
#              0-f, and 1 host holds 2 shards (so 0-f live across ASS1-8). The host + port +
#              dbname for each shard go inside that shard's DSN below; the server keys by hex.
#   staging  — ONE instance holding every database (mad, shard_0 … shard_f). One base DSN; the
#              server swaps the dbname per target, so there is nothing per-shard to maintain.
#
# Shard selection at call time: target="mad" (explicit only) OR target=<hex> OR
# agency_id=<id> (shard = first char of the agency id).

# --- Tunnel sidecars (optional — for managed Postgres behind a VPC) ----------------------
# A managed Postgres is usually not reachable from a laptop. Declare a _TUNNEL sidecar beside
# each target DSN that needs one; the MCP opens a gcloud IAP port-forward lazily and reaps it
# on idle or disconnect. Targets without a sidecar connect directly (no change to today's
# behaviour).
#
# Supported keys (semicolon-separated key=value):
#   tunnel   gcloud | none  (none = already reachable via VPN/bastion; default: gcloud)
#   host     the Postgres hostname as seen FROM the VM — not your laptop
#   port     remote Postgres port (default: 5432)
#   local    local port on 127.0.0.1 — must be UNIQUE across all sidecars, must NOT be 5432
#   vm       gcloud compute instance name (required for tunnel=gcloud)
#   zone     gcloud zone (optional — uses gcloud config default when omitted)
#   project  gcloud project (optional — uses gcloud config default when omitted)
#   iap      true | false — use --tunnel-through-iap (default: true; requires the IAP role)
#
# Naming rules:
#   - A target may NOT be named "…_tunnel" — the suffix is reserved for sidecars (same class of
#     limitation as "dsn" being reserved for the staging base DSN in pg_staging.RESERVED).
#   - PGSTG_DSN_TUNNEL is not supported — the bare staging instance has no target name; declare
#     PGSTG_<NAME>=... and PGSTG_<NAME>_TUNNEL=... per target instead.
#
# Example — prod target behind IAP:
# PGPROD_MAIN_TUNNEL=tunnel=gcloud;host=prod-db.internal;port=5432;local=15432;vm=bastion-vm;zone=asia-southeast1-a
#
# Example — staging target, IAP optional:
# PGSTG_SECONDARY_TUNNEL=tunnel=gcloud;host=stg-db.internal;port=5432;local=15433;vm=stg-bastion;iap=false
#
# Example — target already reachable (VPN / your own bastion):
# PGPROD_MAIN_TUNNEL=tunnel=none

# --- LOCAL maintenance DBs — write targets for prod_repro_seed.py -------------------------
# Used ONLY by prod_repro_seed.py to CREATE/DROP the throwaway `ofb_repro_<ticket>_<seed>` DBs
# and load masked, prod-derived rows during /diagnosing-bugs. LOCAL accounts with CREATEDB/
# DROPDB rights (NOT prod) — never point any of these at prod. Leave unset on machines that
# don't run repro seeding; the read-only triage MCP never uses them.
#
# OFB is split-topology, so a repro often needs BOTH the master and a shard present locally.
# Point each at the LOCAL instance that mirrors that prod tier (default local ports: master
# 5432, shard 5433 — see the ofb-local-db MCP setup). The maintenance dbname is `postgres`
# (never the ofb_repro DB — you can't create/drop a DB you're connected to). A seed picks its
# instance by `local.admin_env` in the spec; teardown/list sweep all three.
PGLOCAL_MAD_ADMIN=postgresql://postgres:postgres@localhost:5432/postgres
PGLOCAL_ASS_ADMIN=postgresql://postgres:postgres@localhost:5433/postgres
# Fallback used when a seed names no admin_env (single-source shorthand specs).
PGLOCAL_ADMIN=postgresql://postgres:postgres@localhost:5432/postgres

# --- STAGING — ONE base DSN for the whole instance (env="staging") ------------------------
# The dbname you put here is irrelevant: the server replaces it per target. Read-only role, same
# hard rule as prod. Leave unset on a machine that does no staging triage — every staging target
# then reports "unconfigured".
PGSTG_DSN=postgresql://readonly:CHANGEME@stg-host:5432/postgres?sslmode=require

# Which staging DATABASE each target maps to. Deployment-specific, so it is configured here
# rather than compiled into the server (scripts/lib/pg_staging.py). `%s` in the shard pattern is
# the shard hex; a pattern with NO `%s` points every shard at one database. Both are optional —
# omit them to keep the defaults shown.
#   PGSTG_DB_MAD=master        PGSTG_DB_ASS_FMT=players_%s    -> master, players_a
#   PGSTG_DB_MAD=ofb_staging   PGSTG_DB_ASS_FMT=ofb_staging   -> one database for every target
PGSTG_DB_MAD=mad
PGSTG_DB_ASS_FMT=shard_%s

# --- PRODUCTION (env="prod") — also gated by triage.prod in workspace.config.local.yaml ---
# --- MAD (master) — explicit target="mad" only, never auto-resolved ----------------------
PGPROD_MAD=postgresql://readonly:CHANGEME@mad-host:5432/mad?sslmode=require

# --- ASS shards (hex 0-f). Point each to the host that owns it (1 host = 2 shards). -------
PGPROD_ASS_0=postgresql://readonly:CHANGEME@ass1-host:5432/shard_0?sslmode=require
PGPROD_ASS_1=postgresql://readonly:CHANGEME@ass1-host:5432/shard_1?sslmode=require
PGPROD_ASS_2=postgresql://readonly:CHANGEME@ass2-host:5432/shard_2?sslmode=require
PGPROD_ASS_3=postgresql://readonly:CHANGEME@ass2-host:5432/shard_3?sslmode=require
PGPROD_ASS_4=postgresql://readonly:CHANGEME@ass3-host:5432/shard_4?sslmode=require
PGPROD_ASS_5=postgresql://readonly:CHANGEME@ass3-host:5432/shard_5?sslmode=require
PGPROD_ASS_6=postgresql://readonly:CHANGEME@ass4-host:5432/shard_6?sslmode=require
PGPROD_ASS_7=postgresql://readonly:CHANGEME@ass4-host:5432/shard_7?sslmode=require
PGPROD_ASS_8=postgresql://readonly:CHANGEME@ass5-host:5432/shard_8?sslmode=require
PGPROD_ASS_9=postgresql://readonly:CHANGEME@ass5-host:5432/shard_9?sslmode=require
PGPROD_ASS_A=postgresql://readonly:CHANGEME@ass6-host:5432/shard_a?sslmode=require
PGPROD_ASS_B=postgresql://readonly:CHANGEME@ass6-host:5432/shard_b?sslmode=require
PGPROD_ASS_C=postgresql://readonly:CHANGEME@ass7-host:5432/shard_c?sslmode=require
PGPROD_ASS_D=postgresql://readonly:CHANGEME@ass7-host:5432/shard_d?sslmode=require
PGPROD_ASS_E=postgresql://readonly:CHANGEME@ass8-host:5432/shard_e?sslmode=require
PGPROD_ASS_F=postgresql://readonly:CHANGEME@ass8-host:5432/shard_f?sslmode=require
