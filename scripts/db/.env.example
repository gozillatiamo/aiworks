# pg-triage — READ-ONLY production Postgres DSNs.
#
# Copy to scripts/db/.env and fill in real values. The real .env is git-ignored (blanket
# .env rule) AND blocked by the workspace .env-guard hook — never Read/cat/grep it; only
# the pg_triage_mcp.py server process reads it.
#
# HARD RULE: every DSN here — staging included — MUST use a READ-ONLY database role. The server also forces a
# read-only transaction + 15s statement_timeout as a backstop, but the read-only role is
# the real guarantee. Do not put a read-write account here.
#
# Targets are just names: set PGPROD_<NAME> and address it as target="<name>" at call time
# (PGPROD_MAIN -> target="main"). Nothing about your topology is assumed until you declare it:
# a database is a named target unless a SHARD_<hex> token in its name, or a _SHARD sidecar
# beside it, declares its shard role (see "Shards (optional)" in README.md). Add as many as
# you need.

# Which environment a call touches is chosen per call by `env` ("staging" | "prod"), never
# defaulted; PRODUCTION is additionally gated by `triage.prod` in workspace.config.local.yaml.

# --- STAGING read-only targets (env="staging") -------------------------------------------
# Two shapes, both supported — use whichever matches your staging:
#   a) one DSN per target, mirroring prod:      PGSTG_<NAME>
#   b) ONE instance holding a database per target: set PGSTG_DSN once; the database defaults to
#      the target name, override it per target with PGSTG_DB_<NAME>
# Leave unset on a machine that does no staging triage — those targets report "unconfigured".
PGSTG_DSN=postgresql://readonly:CHANGEME@stg-host:5432/postgres?sslmode=require
# PGSTG_DB_MAIN=app_main            # only if the database isn't simply the target name
# PGSTG_DB_SHARD_FMT=shard_%s       # database for a shard target (%s = the hex); this is the default
# PGSTG_SECONDARY=postgresql://readonly:CHANGEME@stg-other-host:5432/app?sslmode=require

# --- PROD read-only targets (add one per database you triage) ----------------------------
PGPROD_MAIN=postgresql://readonly:CHANGEME@prod-main-host:5432/app?sslmode=require
PGPROD_SECONDARY=postgresql://readonly:CHANGEME@prod-secondary-host:5432/app?sslmode=require
PGPROD_REPORTING=postgresql://readonly:CHANGEME@prod-reporting-host:5432/reports?sslmode=require

# --- Shards (optional) — declare the role; nothing is assumed until you do -----------------
# Up to 16 databases keyed by one hex digit 0-f. Either put the token in the name ...
# PGPROD_SHARD_0=postgresql://readonly:CHANGEME@prod-shard-host:5432/shard_0?sslmode=require
# PGPROD_HOST1_SHARD_1=postgresql://readonly:CHANGEME@host1:5432/shard_1?sslmode=require   # <LABEL> is free-form
# ... or keep a named var and add a _SHARD sidecar beside it:
# PGPROD_ANALYTICS=postgresql://readonly:CHANGEME@analytics-host:5432/shard_a?sslmode=require
# PGPROD_ANALYTICS_SHARD=a
# Each is addressed as target="<hex>" (key shard_<hex>); resolve_shard(routing_key) picks the shard
# from an identifier's first character. Two vars claiming one hex = conflict; that shard stays
# unconfigured until you fix it here. PGPROD_SHARD0 (no underscore) is an ordinary named target.

# --- Tunnel sidecars (optional — for managed Postgres behind a VPC) ----------------------
# A managed Postgres is usually not reachable from a laptop. Declare a _TUNNEL sidecar beside
# each target DSN that needs one; the MCP opens a gcloud IAP port-forward (or the shared gost
# SOCKS forwarder) lazily and reaps it on idle or disconnect. Targets without a sidecar connect
# directly — --selftest prints a non-failing WARN about that for each prod target.
#
# Supported keys (semicolon-separated key=value):
#   tunnel   gcloud | gost | none  (none = already reachable via VPN/bastion; default: gcloud)
#   host     the Postgres hostname as seen FROM the VM — not your laptop (gcloud only)
#   port     remote Postgres port (default: 5432; gcloud only)
#   local    local port on 127.0.0.1, never 5432. gcloud: must be UNIQUE across all sidecars.
#            gost: the service port in your gost.yaml (two targets on one host share one); must
#            not overlap any gcloud port. Hosts for gost live in gost.yaml, never in the sidecar.
#   vm       gcloud compute instance name (required for tunnel=gcloud)
#   zone     gcloud zone (optional — uses gcloud config default when omitted)
#   project  gcloud project (optional — uses gcloud config default when omitted)
#   iap      true | false — use --tunnel-through-iap (default: true; requires the IAP role)
#
# Naming rules:
#   - A target may NOT be named "…_tunnel" — the suffix is reserved for sidecars (same class of
#     limitation as "dsn" being reserved for the staging base DSN in pg_staging.RESERVED).
#   - PGSTG_DSN_TUNNEL is not supported — the bare staging instance has no target name; declare
#     PGSTG_<NAME>=... and PGSTG_<NAME>_TUNNEL=... per target instead.
#
# Example — prod target behind IAP:
# PGPROD_MAIN_TUNNEL=tunnel=gcloud;host=prod-db.internal;port=5432;local=15432;vm=bastion-vm;zone=asia-southeast1-a
#
# Example — staging target, IAP optional:
# PGSTG_SECONDARY_TUNNEL=tunnel=gcloud;host=stg-db.internal;port=5432;local=15433;vm=stg-bastion;iap=false
#
# Example — prod through the shared gost SOCKS forwarder (brew install gost). One gost process
# serves every tunnel=gost target; hosts live in gost.yaml, keep socks.auth beside it:
# PG_TRIAGE_GOST_CONFIG=path/to/gost.yaml   # absolute, or relative to the workspace root
# PGPROD_MAIN_TUNNEL=tunnel=gost;local=65432
# PGPROD_SECONDARY_TUNNEL=tunnel=gost;local=65433
#
# Example — target already reachable (VPN / your own bastion):
# PGPROD_MAIN_TUNNEL=tunnel=none

# --- LOCAL maintenance DBs — write targets for prod_repro_seed.py -------------------------
# Used ONLY by prod_repro_seed.py to CREATE/DROP the throwaway `repro_<ticket>_<seed>` DBs
# and load masked, prod-derived rows during /diagnosing-bugs. LOCAL accounts with CREATEDB/
# DROPDB rights (NOT prod) — never point any of these at prod. Leave unset on machines that
# don't run repro seeding; the read-only triage MCP never uses them.
#
# If a repro needs more than one local database present at once (e.g. a service that connects
# to two databases), point each at the LOCAL instance that mirrors that prod target. The
# maintenance dbname is `postgres` (never the repro DB — you can't create/drop a DB you're
# connected to). A seed picks its instance by `local.admin_env` in the spec; teardown/list
# sweep every PGLOCAL_* that is set.
#
# Fallback used when a seed names no admin_env (single-source shorthand specs).
PGLOCAL_ADMIN=postgresql://postgres:postgres@localhost:5432/postgres
# Optional per-instance maintenance DSNs, named to match a seed's local.admin_env:
PGLOCAL_MAIN_ADMIN=postgresql://postgres:postgres@localhost:5432/postgres
PGLOCAL_SECONDARY_ADMIN=postgresql://postgres:postgres@localhost:5433/postgres
